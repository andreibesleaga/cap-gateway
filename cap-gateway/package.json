{
  "name": "cap-gateway",
  "version": "1.0.0",
  "description": "Proof-of-concept distributed mesh gateway that translates Common Alerting Protocol (CAP 1.2) alerts into English - PM2 process file, mesh monitor, lint/format toolchain and smoke test",
  "main": "monitor.js",
  "type": "module",
  "private": true,
  "author": "Andrei N. Besleaga",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "pm2 start all.json",
    "monitor": "node monitor.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "test": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "cote": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
